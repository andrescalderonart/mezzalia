# Copiar a .env (ya está en .gitignore) y completar con valores reales.
# Nunca commitear el .env real.

# Generar con: openssl rand -base64 32
JWT_SECRET=

# Deben coincidir con lo que defina docker-compose.yml para MySQL
DB_USER=carta_digital
DB_PASSWORD=dev_password

# Solo para el perfil `dev` (ver SeedSuperAdminConfig): usuario y contraseña
# del SUPER_ADMIN sembrado en un backend recién levantado, para poder entrar
# la primera vez. Cambiar/quitar apenas exista una gestión real de usuarios.
DEV_SUPERADMIN_USERNAME=superadmin
DEV_SUPERADMIN_PASSWORD=

# Cifra el telefono del comensal en reposo (AES-256-GCM, ver
# pedido.seguridad.TelefonoEncriptadoConverter, documentacion-tecnica.md
# §10). SIN valor por defecto a proposito, mismo criterio que JWT_SECRET: si
# falta, la aplicacion NO arranca (ver ComensalEncriptacionConfig) en vez de
# arrancar sin poder guardar el telefono de un comensal real, o peor,
# guardarlo sin cifrar. Generar con: openssl rand -base64 32
# ADVERTENCIA: si esta clave cambia despues de que ya existan telefonos
# guardados, esos telefonos quedan indescifrables -- no hay rotacion
# automatica implementada todavia.
COMENSAL_ENCRYPTION_KEY=
