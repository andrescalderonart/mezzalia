# Copiar a .env (ya deberia estar en .gitignore) y completar con el valor real.
# Sin esta variable, MesasPage arma la URL del QR contra localhost:5174 (el
# puerto de dev de app-cliente) -- sirve para desarrollo local, pero un QR
# impreso con esa URL es inutil para un comensal fuera de la red del
# desarrollador. En produccion, VITE_APP_CLIENTE_URL debe ser el dominio
# publico real donde se sirve app-cliente.
VITE_APP_CLIENTE_URL=http://localhost:5174
