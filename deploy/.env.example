# Copiar a deploy/.env (ignorado por git) y completar. NUNCA commitear el .env.
# Generar cada secreto con:  openssl rand -base64 32

# Dominios (sus registros DNS tipo A deben apuntar a la IP del servidor).
DOMINIO_CARTA=carta.ejemplo.co
DOMINIO_PANEL=panel.ejemplo.co
# Correo para Let's Encrypt (avisos de vencimiento del certificado).
ACME_EMAIL=

# Base de datos
DB_USER=mezzalia
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Secretos de la aplicacion (sin ellos el backend NO arranca, a proposito).
JWT_SECRET=
COMENSAL_ENCRYPTION_KEY=
COMENSAL_ENCRYPTION_KEY_PREVIOUS=

# Solo el PRIMER arranque: crea el primer SUPER_ADMIN si no existe ninguno.
# Borrar estas dos lineas apenas entres por primera vez.
MEZZALIA_PRIMER_SUPERADMIN_USUARIO=
MEZZALIA_PRIMER_SUPERADMIN_PASSWORD=
